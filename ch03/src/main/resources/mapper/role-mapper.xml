<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 8 -->
<mapper namespace="com.korit.ch03.domain.role.mapper.RoleMapper">

    <insert id="insert" parameterType="Role" useGeneratedKeys="true" keyProperty="id">
        insert into roles values
            (default, #{roleName}, now(), now())
    </insert>

    <select id="findAll" resultType="Role">
        select
            id,
            role_name,
            created_at,
            updated_at
        from
            roles
        order by
            id
    </select>
    <select id="findById" parameterType="Long" resultType="Role">
        select
            id,
            role_name,
            created_at,
            updated_at
        from
            roles
        where
            id = #{id}
        order by
            id
    </select>
    <select id="selectByRolename" resultType="Role">
        select
            id,
            role_name,
            created_at,
            updated_at
        from
            roles
        where
            role_name = #{roleName}
        order by
            id
    </select>

</mapper>